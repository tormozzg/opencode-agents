{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "description": "Plan: the pack's planner - turns a request into ONE brief, decision-complete work plan: bounded size, dependency-annotated task rows, resolved defaults recorded in the plan, acceptance criteria the executor can run. Explores before asking, delegates research to explore only - never dispatches worker, never implements, never starts execution. Runs a mandatory plan-reviewer audit of the written plan before handoff. Use for planning, designing, or breaking down work.",
      "skill": "plan-work"
    },
    "build": {
      "description": "Build: orchestrates execution of a plan or direct task by delegating everything. Loads the lead-work skill first, routes unclear topics to explore and ready work to worker, verifies every claim, runs a mandatory @code-reviewer review and @qa-inspector QA run before any commit, never writes code. Use for running a plan, coordinating waves, or driving work to completion.",
      "skill": "lead-work"
    },
    "discuss": {
      "description": "Discuss: a discussion partner that debates code and improvement proposals - grounds the dialogue in facts via @explore and @code-reviewer, critiques constructively, and hands converged outcomes to plan or build. Never edits project files, never builds plans. Use for talking through designs, weighing alternatives, or pressure-testing an idea before planning.",
      "skill": "discuss-work"
    },
    "worker": {
      "description": "Worker: implements delegated tasks silently and verifies before declaring done. Loads the execute-work discipline first, then writes code, runs diagnostics/build/tests, and reports with evidence. Use for any delegated implementation work.",
      "skill": "execute-work"
    },
    "explore": {
      "description": "Explore: investigates a topic across code, docs, and the web with an evidence-demander stance. Cites every claim, returns numbered concise findings. Use for research, fact-finding, or grounding decisions.",
      "skill": "research-topic"
    },
    "plan-reviewer": {
      "description": "Plan reviewer: reviews draft work plans for executability and valid references. Loads the review-plan skill first, performs Momus + Metis review, returns blockers and notes. Never rewrites plans unless asked.",
      "skill": "review-plan"
    },
    "code-reviewer": {
      "description": "Code reviewer: reviews diffs and completed changes for correctness, quality, and plan fidelity. Loads the review-code skill first, classifies the work type, checks blockers vs notes, returns comments or approval. Never fixes code itself.",
      "skill": "review-code"
    },
    "qa-inspector": {
      "description": "QA inspector: executes the plan's QA scenarios after code-reviewer approval, runs each scenario's commands for real, saves evidence under .opencode/evidence/<plan-name-or-task-slug>/, and returns per-scenario PASS/FAIL with an ALL PASS / N FAILED summary. Read-only to product code. Never fixes code itself. Use for 'run QA', 'QA gate', or 'прогонить QA-сценарии' requests before a commit.",
      "skill": "qa-inspect"
    },
    "git-master": {
      "description": "Git Master: handles atomic commits, rebase/squash/fixup (history rewrite), and history search (blame, bisect, log -S, reflog). Loads the git-master skill first, commits atomically in the pack's fixed commit message format, with the message language detected from history, and protects shared history. Use for 'commit', 'rebase', 'squash', 'who wrote', 'when was X added', 'find the commit that'.",
      "skill": "git-master"
    }
  },
  "skills": {
    "paths": [
      "~/.config/opencode/skills/plan-work/SKILL.md",
      "~/.config/opencode/skills/lead-work/SKILL.md",
      "~/.config/opencode/skills/discuss-work/SKILL.md",
      "~/.config/opencode/skills/research-topic/SKILL.md",
      "~/.config/opencode/skills/execute-work/SKILL.md",
      "~/.config/opencode/skills/review-plan/SKILL.md",
      "~/.config/opencode/skills/review-code/SKILL.md",
      "~/.config/opencode/skills/qa-inspect/SKILL.md",
      "~/.config/opencode/skills/git-master/SKILL.md",
      "~/.config/opencode/skills/code-idiom/SKILL.md",
      "~/.config/opencode/skills/refactor-code/SKILL.md",
      "~/.config/opencode/skills/slop-cleanup/SKILL.md"
    ]
  }
}
